# Helius mainnet API key (https://dashboard.helius.dev)
HELIUS_API_KEY=
PORT=8787
HOST=127.0.0.1
# Scan result cache, ms
SCAN_CACHE_TTL_MS=60000
# Max parallel Helius requests (429s are retried with backoff)
RPC_CONCURRENCY=12
# Vote-only key Sentinel uses to approve guarded (Squads) transactions. base58 secret key.
SENTINEL_APPROVER_SECRET=
# Telegram bot token from @BotFather (owner alerts + approval links)
TELEGRAM_BOT_TOKEN=
